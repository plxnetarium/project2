<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Product | Bluebell</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-light">
  <%- include('./partials/navbar') %>

  <main class="container py-4 py-md-5">
    <div class="mx-auto edit-product-content">
      <header class="mb-4">
        <a href="/admin">← Back to admin dashboard</a>
        <h1 class="fw-bold mt-3 mb-1">Edit product</h1>
        <p class="text-body-secondary mb-0"><%= product.productName %></p>
      </header>

      <% if (error) { %>
        <p class="alert alert-danger" role="alert"><%= error %></p>
      <% } %>

      <form class="bg-white border rounded-3 p-3 p-md-4"
        action="/product/<%= product._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
        <h2 class="h5 fw-bold mb-3">Product details</h2>
        <div class="row g-3">
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold" for="productName">Product name</label>
            <input class="form-control" type="text" id="productName" name="productName" value="<%= product.productName %>" required />
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold" for="categoryName">Category</label>
            <select class="form-select" id="categoryName" name="categoryName" required>
              <option value="">Select a category</option>
              <% categories.forEach((category) => { %>
                <option value="<%= category._id %>" <%= String(product.categoryName) === String(category._id) ? 'selected' : '' %>><%= category.categoryName %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold" for="description">Description</label>
            <textarea class="form-control" id="description" name="description" maxlength="350" rows="4"><%= product.description %></textarea>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold" for="price">Price (BHD)</label>
            <input class="form-control" type="number" id="price" name="price" value="<%= product.price %>" min="0" step="0.001" required />
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold" for="stock">Stock</label>
            <input class="form-control" type="number" id="stock" name="stock" value="<%= product.stock %>" min="0" step="1" required />
          </div>
        </div>

        <div class="border-top mt-4 pt-4">
          <h2 class="h5 fw-bold mb-3">Product photo</h2>
          <div class="mb-3">
            <label class="form-label fw-semibold" for="photo">Replace photo</label>
            <input class="form-control" type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp" aria-describedby="photoHelp" />
            <div class="form-text" id="photoHelp">JPEG, PNG, or WebP, up to 5 MB.</div>
          </div>
          <label class="form-label fw-semibold" for="imageUrl">Image URL</label>
          <input class="form-control" type="text" id="imageUrl" name="imageUrl" value="<%= product.imageUrl %>" />
        </div>

        <div class="d-flex flex-wrap gap-2 border-top mt-4 pt-3">
          <button class="btn btn-primary" type="submit">Save changes</button>
          <a class="btn btn-outline-secondary" href="/product/<%= product._id %>">Cancel</a>
        </div>
      </form>

      <section class="bg-white border border-danger-subtle rounded-3 p-3 p-md-4 mt-4" aria-labelledby="delete-product-heading">
        <h2 class="h5 fw-bold text-danger" id="delete-product-heading">Delete product</h2>
        <form action="/product/<%= product._id %>?_method=DELETE" method="POST">
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="confirmDelete" required />
            <label class="form-check-label" for="confirmDelete">Confirm you want to delete this product</label>
          </div>
          <button type="submit" class="btn btn-outline-danger">Delete product</button>
        </form>
      </section>
    </div>
  </main>
</body>
</html>
