<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cart | Bluebell</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('./partials/navbar') %>
  <main>
    <h1>Your cart</h1>
    <% if (items.length === 0) { %>
      <p>Your cart is empty.</p>
    <% } else { %>
      <% items.forEach((item) => { %>
        <article>
          <h2><a href="/product/<%= item.product._id %>"><%= item.product.productName %></a></h2>
          <p>Price: BHD <%= item.product.price.toFixed(3) %></p>
          <p>Quantity: <%= item.quantity %></p>
          <p>Subtotal: BHD <%= (item.subtotalFils / 1000).toFixed(3) %></p>
          <% if (item.quantity > item.product.stock) { %>
            <p>Stock has changed. Currently available: <%= item.product.stock %>.</p>
          <% } %>
        </article>
      <% }) %>
      <h2>Total: BHD <%= (totalFils / 1000).toFixed(3) %></h2>
    <% } %>
    <a href="/product">Continue shopping</a>
  </main>
</body>
</html>
