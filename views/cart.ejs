<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cart | Bluebell</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('./partials/navbar') %>
  <main class="container py-5 cart-page">
    <h1 class="text-center fw-bold mb-4">Your cart</h1>
    <% if (items.length === 0) { %>
      <p class="border rounded p-4 text-center">Your cart is empty.</p>
    <% } else { %>
      <% const itemCount = items.reduce((count, item) => count + item.quantity, 0); %>
      <div class="row g-4 align-items-start">
        <section class="col-12 col-lg-8" aria-label="Cart items">
          <div class="border rounded overflow-hidden">
            <% items.forEach((item) => { %>
              <% const imageUrl = (item.product.imageUrl || '').trim(); %>
              <article class="cart-item p-3 p-sm-4">
                <div class="d-flex flex-wrap gap-3 align-items-center">
                  <% if (/^https?:\/\//i.test(imageUrl) || /^\/(?!\/)/.test(imageUrl)) { %>
                    <img class="cart-thumbnail rounded" src="<%= imageUrl %>" alt="" loading="lazy" />
                  <% } %>
                  <div class="flex-grow-1">
                    <h2 class="h5 mb-1"><a href="/product/<%= item.product._id %>"><%= item.product.productName %></a></h2>
                    <p class="mb-0">BHD <%= item.product.price.toFixed(3) %> each</p>
                  </div>
                  <p class="mb-0">Quantity: <%= item.quantity %></p>
                  <p class="mb-0">Subtotal: <strong>BHD <%= (item.subtotalFils / 1000).toFixed(3) %></strong></p>
                </div>
                <% if (item.quantity > item.product.stock) { %>
                  <p class="mt-3 mb-0">Stock has changed. Currently available: <%= item.product.stock %>.</p>
                <% } %>
              </article>
            <% }) %>
          </div>
        </section>
        <aside class="col-12 col-lg-4" aria-labelledby="cart-summary-title">
          <div class="cart-summary rounded p-4">
            <h2 class="h4 fw-bold" id="cart-summary-title">Order summary</h2>
            <p><%= itemCount %> <%= itemCount === 1 ? 'item' : 'items' %></p>
            <div class="d-flex flex-wrap justify-content-between gap-2 border-top pt-3 fw-bold">
              <span>Total</span>
              <strong>BHD <%= (totalFils / 1000).toFixed(3) %></strong>
            </div>
          </div>
        </aside>
      </div>
    <% } %>
    <a class="d-inline-block mt-4" href="/product">Continue shopping</a>
  </main>
</body>
</html>
