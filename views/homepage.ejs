<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="home-page">
    <%- include('./partials/navbar') %>

    <main class="home-hero">
        <div class="hero-copy">
            <h1>Find your next upgrade.</h1>
            <p>Computers and accessories for work, study, and play.</p>

            <form class="hero-search" action="/product" method="GET">
                <input type="search" id="searchInput" name="search"
                    aria-label="Search products by name or description"
                    placeholder="Search by name or description" />
                <button type="submit">Search</button>
            </form>

            <a href="/product">Browse all products</a>
        </div>

        <%# Add the hero image here when its file is in public/photos. %>
    </main>

</body>

</html>
