<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Forgot Password | Bluebell</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="/photos/favicon.ico" sizes="any" />
</head>
<body>
  <%- include('../partials/navbar') %>
  <main class="auth-page">
    <div class="auth-card">
      <h1>Forgot password?</h1>
      <p class="auth-description">Enter the email address you use to sign in to Bluebell.</p>

      <% if (message) { %>
        <div class="reset-toast" role="status" aria-atomic="true">
          <strong>Reset requested</strong>
          <p><%= message %></p>
        </div>
      <% } %>

      <form class="auth-form" action="/auth/forgot-password" method="POST">
        <div class="auth-field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>
        <button type="submit">Send reset link</button>
      </form>

      <p class="auth-footer"><a href="/auth/sign-in">Back to sign in</a></p>
    </div>
  </main>
</body>
</html>
