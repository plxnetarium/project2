<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard | Bluebell</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/photos/favicon.ico" sizes="any" />
</head>
<body>
  <%- include('./partials/navbar') %>

  <main class="container py-5">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <h1 class="fw-bold">Admin dashboard</h1>
        <p class="text-body-secondary mb-0">Manage your Bluebell product catalogue.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/product/new">Add product</a>
        <a class="btn btn-outline-primary" href="/category/new">Add category</a>
      </div>
    </header>

    <div class="row g-4 align-items-start">
      <div class="col-12<%= products.length > 0 ? ' col-lg-8' : '' %>">
    <dl class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
      <div class="col"><div class="bg-light rounded border p-3">
        <dt>Products</dt><dd class="fs-3 fw-bold mb-0"><%= products.length %></dd>
      </div></div>
      <div class="col"><div class="bg-light rounded border p-3">
        <dt>Categories</dt><dd class="fs-3 fw-bold mb-0"><%= categoryCount %></dd>
      </div></div>
      <div class="col"><div class="bg-light rounded border p-3">
        <dt>Out of stock</dt><dd class="fs-3 fw-bold mb-0"><%= outOfStockCount %></dd>
      </div></div>
    </dl>

      <section aria-labelledby="dashboard-products">
        <h2 id="dashboard-products" class="h4 fw-bold mb-3">Products</h2>
        <% if (products.length === 0) { %>
          <p class="border rounded p-4">No products yet. <a href="/product/new">Add your first product</a>.</p>
        <% } else { %>
          <div class="table-responsive border rounded" tabindex="0" role="region" aria-label="Product inventory">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col">Product</th>
                  <th scope="col">Category</th>
                  <th scope="col">Price</th>
                  <th scope="col">Stock</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach((product) => { %>
                  <% const imageUrl = (product.imageUrl || '').trim(); %>
                  <tr>
                    <th scope="row">
                      <div class="d-flex align-items-center gap-2">
                        <% if (/^https?:\/\//i.test(imageUrl) || /^\/(?!\/)/.test(imageUrl)) { %>
                          <img class="rounded object-fit-contain" src="<%= imageUrl %>" alt="" width="48" height="48" loading="lazy" />
                        <% } %>
                        <a href="/product/<%= product._id %>"><%= product.productName %></a>
                      </div>
                    </th>
                    <td><%= product.categoryName?.categoryName || 'Uncategorised' %></td>
                    <td class="text-nowrap">BHD <%= product.price.toFixed(3) %></td>
                    <td><%= product.stock > 0 ? product.stock : 'Out of stock' %></td>
                    <td><a class="btn btn-sm btn-outline-primary" href="/product/<%= product._id %>/edit" aria-label="Edit <%= product.productName %>">Edit</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
      </div>

      <% if (products.length > 0) { %>
        <% const inStockCount = products.length - outOfStockCount; %>
        <section class="col-12 col-lg-4" aria-labelledby="inventory-heading">
          <div class="bg-white border rounded-3 p-4">
          <h2 id="inventory-heading" class="h4 fw-bold">Inventory breakdown</h2>
          <p class="text-body-secondary">Product listings by stock status</p>

          <div class="d-flex flex-column gap-3">
            <div class="w-100">
              <div class="inventory-chart">
                <canvas id="inventoryChart" role="img"
                  aria-label="<%= inStockCount %> products in stock, <%= outOfStockCount %> out of stock"
                  data-in-stock="<%= inStockCount %>"
                  data-out-of-stock="<%= outOfStockCount %>"></canvas>
              </div>
            </div>
            <div>
              <dl class="row row-cols-2 mb-0">
                <div class="col">
                <dt>In stock</dt>
                <dd class="fs-4 fw-bold text-primary"><%= inStockCount %></dd>
                </div>
                <div class="col">
                <dt>Out of stock</dt>
                <dd class="fs-4 fw-bold mb-0"><%= outOfStockCount %></dd>
                </div>
              </dl>
            </div>
          </div>
          </div>
        </section>
        <script src="/js/chart.umd.min.js" defer></script>
        <script src="/js/admin-chart.js" defer></script>
      <% } %>
    </div>
  </main>
</body>
</html>
